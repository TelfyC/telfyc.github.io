    <div class="mb-5">
        <div class="text-3xl w-full font-bold">教育经历</div>
    </div>

    <div class="time-line-container grid gap-4 mb-10">
        <TimeLineElement
            title="计算机科学与技术 · 本科"
            subtitle="2017 - 2021，上海海洋大学"
        />
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">工作经历</div>
    </div>

    <div class="time-line-container mb-10">
        <TimeLineElement
            title="前端开发工程师 · 上海丰蕾信息科技有限公司"
            subtitle="2023.12 - 至今"
        >
            工作内容覆盖 Web 平台、移动端 App 与桌面端采集软件，聚焦工业 IoT 场景下的设备管理、数据采集与固件升级。负责公司核心前端产品建设，覆盖生产追溯平台（PLTS/OTA）、工业 IoT App（未界智联）与桌面端数据采集软件（Vxspace），持续推进跨端业务交付。
        </TimeLineElement>
        <TimeLineElement
            title="前端开发工程师 · 上海博动医疗科技股份有限公司"
            subtitle="2021.06 - 2023.11"
        >
            参与 ERP 系统、Azure DevOps Web 端插件与医疗影像分析系统（CTQFR）开发，具备中后台、插件化产品与复杂图形交互场景下的前端交付经验。
        </TimeLineElement>
    </div>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">资格证书</div>
    </div>

    <ul class="list-disc mx-6 mb-10 grid gap-2">
        <li>大学英语六级（CET-6）</li>
    </ul>

    <div class="mb-5">
        <div class="text-3xl w-full font-bold">技能</div>
    </div>
    <ul class="list-disc mx-6 grid gap-1">
        <li><strong>框架 / 平台：</strong>React · React Native · Electron · Umi · Astro</li>
        <li><strong>状态 / 数据：</strong>Zustand · TanStack Query · dnd-kit</li>
        <li><strong>图形 / 可视化：</strong>PixiJS · Three.js · ECharts</li>
        <li><strong>通信 / 协议：</strong>BLE · KCP ARQ · TCP · WebSocket · OTA</li>
        <li><strong>数据持久化：</strong>SQLite · Sequelize</li>
        <li><strong>语言 / 工具：</strong>TypeScript · Git · 微前端</li>
    </ul>
</BaseLayout>
